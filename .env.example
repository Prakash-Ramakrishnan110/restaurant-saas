# ==============================================================================
# Fusion Engine Restaurant SaaS - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Django Core Settings ---
DEBUG=True
SECRET_KEY=replace-with-a-very-strong-secret-key-at-least-50-characters-long
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database (PostgreSQL 16) ---
DB_NAME=fusion_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Redis 7) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery Configuration ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT / Auth Settings ---
JWT_SIGNING_KEY=replace-with-jwt-signing-key-or-defaults-to-secret-key
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# --- Platform Defaults ---
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
