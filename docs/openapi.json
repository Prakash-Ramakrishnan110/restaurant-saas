  /api/v1/staff/:
    get:
      operationId: staff_list
      description: Staff management endpoints scoped to the active tenant.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - staff
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedStaffDetailList'
          description: ''
    post:
      operationId: staff_create
      description: Staff management endpoints scoped to the active tenant.
      tags:
      - staff
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/StaffDetailRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/StaffDetailRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/StaffDetailRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StaffDetail'
          description: ''
  /api/v1/staff-assignments/:
    get:
      operationId: staff_assignments_list
      description: Assign staff members to sections.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - staff-assignments
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedStaffSectionAssignmentList'
          description: ''
    post:
      operationId: staff_assignments_create
