components:
  schemas:
    AreaType:
      enum:
      - DINING
      - BAR
      - COUNTER
      - OUTDOOR
      - ROOM_SERVICE
      - BANQUET
      - FOOD_COURT_COUNTER
      - TAKEAWAY
      type: string
      description: |-
        * `DINING` - Dining Area
        * `BAR` - Bar / Lounge
        * `COUNTER` - Order Counter
        * `OUTDOOR` - Outdoor / Patio
        * `ROOM_SERVICE` - Hotel Room Service
        * `BANQUET` - Banquet / Event Hall
        * `FOOD_COURT_COUNTER` - Food Court Stall Counter
        * `TAKEAWAY` - Takeaway Pickup Point
    AuthMeResponse:
      type: object
      properties:
        user:
          $ref: '#/components/schemas/User'
        memberships:
          type: array
          items:
            $ref: '#/components/schemas/MembershipSummary'
        active_tenant_id:
          type: string
          format: uuid
          nullable: true
        active_role:
          type: string
          nullable: true
        permissions:
          type: array
          items:
            type: string
      required:
      - active_role
      - active_tenant_id
      - memberships
      - permissions
      - user
    Branch:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 255
        address:
          type: string
        phone:
          type: string
          maxLength: 32
        venue_profile:
          $ref: '#/components/schemas/VenueProfile'
        is_active:
          type: boolean
        operating_hours: {}
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - name
      - updated_at
    BranchCapabilities:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        branch:
          type: string
          format: uuid
          readOnly: true
        uses_tables:
          type: boolean
        uses_kds:
          type: boolean
        uses_token_numbers:
          type: boolean
        allows_takeaway:
          type: boolean
        allows_room_service:
          type: boolean
        allows_room_charge:
          type: boolean
        allows_qr_ordering:
          type: boolean
        has_sections:
          type: boolean
        has_seat_ordering:
          type: boolean
        supports_courses:
          type: boolean
        allows_table_transfer:
          type: boolean
        payment_timing:
          $ref: '#/components/schemas/PaymentTiming'
        qr_ordering_mode:
          $ref: '#/components/schemas/QrOrderingMode'
        qr_session_policy:
          $ref: '#/components/schemas/QrSessionPolicy'
        order_workflow:
          $ref: '#/components/schemas/OrderWorkflow'
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - branch
      - created_at
      - id
      - updated_at
    BranchRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 255
        address:
          type: string
        phone:
          type: string
          maxLength: 32
        venue_profile:
          $ref: '#/components/schemas/VenueProfile'
        is_active:
          type: boolean
        operating_hours: {}
      required:
      - name
    BranchSummary:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 255
        is_active:
          type: boolean
      required:
      - id
      - name
    BranchSummaryRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 255
        is_active:
          type: boolean
      required:
      - name
    BusinessLogoResponse:
      type: object
      properties:
        logo_url:
          type: string
        logo_128_url:
          type: string
      required:
      - logo_128_url
      - logo_url
    BusinessLogoResponseRequest:
      type: object
      properties:
        logo_url:
          type: string
        logo_128_url:
          type: string
      required:
      - logo_128_url
      - logo_url
    BusinessProfile:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 255
        slug:
          type: string
          readOnly: true
          pattern: ^[-a-zA-Z0-9_]+$
        business_type:
          $ref: '#/components/schemas/BusinessType'
        status:
          allOf:
          - $ref: '#/components/schemas/TenantStatus'
          readOnly: true
        subscription_status:
          type: string
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        phone:
          type: string
          maxLength: 32
        timezone:
          type: string
          maxLength: 64
        currency:
          type: string
          readOnly: true
        address:
          type: string
        invoice_prefix:
          type: string
        logo_url:
          type: string
        logo_128_url:
          type: string
          readOnly: true
        primary_color:
          type: string
        brand_primary_color:
          type: string
        legal_name:
          type: string
        gstin:
          type: string
        registered_address:
          type: string
        document_language:
          $ref: '#/components/schemas/DocumentLanguageEnum'
        receipt_footer_text:
          type: string
          maxLength: 200
        tax_mode:
          $ref: '#/components/schemas/TaxMode'
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - currency
      - id
      - logo_128_url
      - name
      - slug
      - status
      - subscription_status
      - updated_at
    BusinessSettings:
      type: object
      properties:
        tax_mode:
          $ref: '#/components/schemas/TaxMode'
        invoice_prefix:
          type: string
          maxLength: 20
        logo_url:
          type: string
          maxLength: 500
        logo_128_url:
          type: string
          maxLength: 500
        primary_color:
          type: string
          maxLength: 16
        brand_primary_color:
          type: string
          maxLength: 7
        legal_name:
          type: string
          maxLength: 255
        gstin:
          type: string
          maxLength: 15
        registered_address:
