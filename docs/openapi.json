components:
  schemas:
    AreaTypeEnum:
      enum:
      - DINING
      - BAR
      - COUNTER
      - OUTDOOR
      - ROOM_SERVICE
      - BANQUET
      - FOOD_COURT_COUNTER
      - TAKEAWAY
      type: string
      description: |-
        * `DINING` - Dining Area
        * `BAR` - Bar / Lounge
        * `COUNTER` - Order Counter
        * `OUTDOOR` - Outdoor / Patio
        * `ROOM_SERVICE` - Hotel Room Service
        * `BANQUET` - Banquet / Event Hall
        * `FOOD_COURT_COUNTER` - Food Court Stall Counter
        * `TAKEAWAY` - Takeaway Pickup Point
    AuthMeResponse:
      type: object
      properties:
        user:
          $ref: '#/components/schemas/User'
        memberships:
          type: array
          items:
            $ref: '#/components/schemas/MembershipSummary'
        active_tenant_id:
          type: string
          format: uuid
          nullable: true
        active_role:
          type: string
          nullable: true
        permissions:
          type: array
          items:
            type: string
      required:
      - active_role
      - active_tenant_id
      - memberships
      - permissions
      - user
    BranchSummary:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 255
        is_active:
          type: boolean
      required:
      - id
      - name
    BusinessProfile:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 255
        slug:
          type: string
          readOnly: true
          pattern: ^[-a-zA-Z0-9_]+$
        business_type:
          $ref: '#/components/schemas/BusinessTypeEnum'
        status:
          allOf:
          - $ref: '#/components/schemas/BusinessProfileStatusEnum'
          readOnly: true
        subscription_status:
          type: string
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        phone:
          type: string
          maxLength: 32
        timezone:
          type: string
          maxLength: 64
        currency:
          type: string
          readOnly: true
        invoice_prefix:
          type: string
        logo_url:
          type: string
        primary_color:
          type: string
        tax_mode:
          $ref: '#/components/schemas/TaxModeEnum'
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - currency
      - id
      - name
      - slug
      - status
      - subscription_status
      - updated_at
    BusinessProfileStatusEnum:
      enum:
      - ACTIVE
      - SUSPENDED
      type: string
      description: |-
        * `ACTIVE` - Active
        * `SUSPENDED` - Suspended
    BusinessTypeEnum:
      enum:
      - TEA_SHOP
      - BAKERY
      - CAFE
      - RESTAURANT
      - FINE_DINING
      - HOTEL
      - FOOD_COURT
      - CHAIN
      type: string
      description: |-
        * `TEA_SHOP` - Tea Shop
        * `BAKERY` - Bakery
        * `CAFE` - Café
        * `RESTAURANT` - Restaurant
        * `FINE_DINING` - Fine Dining
        * `HOTEL` - Hotel
        * `FOOD_COURT` - Food Court
        * `CHAIN` - Chain
    DiningTable:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        branch:
          type: string
          format: uuid
        section:
          type: string
          format: uuid
        label:
          type: string
          description: e.g. T12, Room 301, Counter 2
          maxLength: 50
