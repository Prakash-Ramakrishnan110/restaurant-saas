openapi: 3.0.3
info:
  title: Fusion Engine Restaurant SaaS API
  version: 1.0.0
  description: Multi-tenant Restaurant Management SaaS backend foundation API
paths:
  /api/v1/auth/change-password/:
    post:
      operationId: auth_change_password_create
      description: Authenticated endpoint to change password, revoke prior sessions,
        and issue fresh access token.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChangePasswordRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ChangePasswordRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ChangePasswordRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          description: Password changed successfully
  /api/v1/auth/login/:
    post:
      operationId: auth_login_create
      description: Authenticates credentials, sets rotating httpOnly refresh cookie,
        and returns access token.
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequestRequest'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LoginResponse'
          description: ''
        '400':
          description: Validation error
        '401':
          description: Invalid credentials or account inactive
        '429':
          description: Rate limit exceeded
  /api/v1/auth/logout/:
    post:
      operationId: auth_logout_create
      description: Blacklists refresh token, deletes refresh cookie, returns 204.
      summary: User logout
      tags:
      - auth
      security:
      - optionalJwtAuth: []
      - {}
      responses:
        '204':
          description: Logged out successfully
  /api/v1/auth/me/:
    get:
      operationId: auth_me_retrieve
      description: Returns profile of the authenticated user, all memberships, and
        permissions for active tenant.
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthMeResponse'
          description: ''
  /api/v1/auth/refresh/:
    post:
      operationId: auth_refresh_create
      description: Refreshes access token and rotates the httpOnly refresh cookie.
      tags:
      - auth
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: Token refreshed successfully
        '401':
          description: Invalid or expired refresh token
        '403':
          description: Invalid request origin
  /api/v1/branches/:
    get:
      operationId: branches_list
      description: Branch management endpoints scoped to the active tenant.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - branches
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedBranchList'
          description: ''
    post:
      operationId: branches_create
      description: Branch management endpoints scoped to the active tenant.
      tags:
      - branches
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BranchRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/BranchRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/BranchRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Branch'
          description: ''
  /api/v1/branches/{branch_id}/capabilities/:
    get:
      operationId: branches_capabilities_retrieve
      description: Retrieve or update capabilities configuration for a branch.
      parameters:
      - in: path
        name: branch_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - branches
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BranchCapabilities'
          description: ''
    patch:
      operationId: branches_capabilities_partial_update
      description: Retrieve or update capabilities configuration for a branch.
      parameters:
      - in: path
        name: branch_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - branches
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedBranchCapabilitiesRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedBranchCapabilitiesRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedBranchCapabilitiesRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BranchCapabilities'
          description: ''
  /api/v1/branches/{branch_id}/layout-templates/{key}/apply/:
    post:
      operationId: branches_layout_templates_apply_create
      description: Atomically creates areas, sections, and tables or counters from
        template. Pre-checks subscription entitlements.
      summary: Apply layout template
      parameters:
      - in: path
        name: branch_id
        schema:
          type: string
          format: uuid
        required: true
      - in: path
        name: key
        schema:
          type: string
        required: true
      tags:
      - branches
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LayoutTemplateApplyResponseRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LayoutTemplateApplyResponseRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LayoutTemplateApplyResponseRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LayoutTemplateApplyResponse'
          description: ''
  /api/v1/branches/{id}/:
    get:
      operationId: branches_retrieve
      description: Branch management endpoints scoped to the active tenant.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - branches
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Branch'
          description: ''
    patch:
      operationId: branches_partial_update
      description: Branch management endpoints scoped to the active tenant.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - branches
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedBranchRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedBranchRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedBranchRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Branch'
          description: ''
    delete:
      operationId: branches_destroy
      description: Branch management endpoints scoped to the active tenant.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - branches
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/business/:
    get:
      operationId: business_retrieve
      description: Returns profile and settings for the active tenant context.
      summary: Get active business profile
      tags:
      - business
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BusinessProfile'
          description: ''
    patch:
      operationId: business_partial_update
      description: Update profile and settings for the active tenant context. Audited.
      summary: Update active business profile
      tags:
      - business
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedBusinessProfileRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedBusinessProfileRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedBusinessProfileRequest'
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BusinessProfile'
          description: ''
  /api/v1/business/logo/:
    post:
      operationId: business_logo_create
      description: Upload PNG, JPEG, or WebP logo (max 2MB, max 4000x4000). Strips
        metadata, produces 512px and 128px versions. Audited.
      summary: Upload business logo
      tags:
      - business
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/BusinessLogoResponseRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/BusinessLogoResponseRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/BusinessLogoResponseRequest'
        required: true
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BusinessLogoResponse'
          description: ''
    delete:
      operationId: business_logo_destroy
      description: Delete current business logo and clear logo URLs. Audited.
      summary: Delete business logo
      tags:
      - business
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BusinessLogoResponse'
          description: ''
  /api/v1/entitlements/:
    get:
      operationId: entitlements_retrieve
      description: Returns plan name, subscription status, numeric limits with remaining
        headroom, and feature flags.
      summary: Get tenant subscription entitlements and usage
      tags:
      - entitlements
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/layout-templates/:
    get:
      operationId: layout_templates_list
      description: Returns catalog of predefined layout templates for venue onboarding
        and layout setup.
      summary: List layout templates
      tags:
      - layout-templates
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/LayoutTemplateCatalogItem'
          description: ''
  /api/v1/onboarding/status/:
    get:
      operationId: onboarding_status_retrieve
      description: Returns completion checklist for tenant onboarding wizard.
      summary: Get tenant onboarding status
      tags:
      - onboarding
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OnboardingStatus'
          description: ''
  /api/v1/public/qr/{token}/:
    get:
      operationId: public_qr_retrieve
      description: Public unauthenticated endpoint to resolve a scanned QR code token.
      parameters:
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - public
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PublicQRDetail'
          description: ''
  /api/v1/public/qr/{token}/session/:
    post:
      operationId: public_qr_session_create
      description: Public unauthenticated endpoint for diner to open or rejoin a table
        session.
      parameters:
      - in: path
        name: token
        schema:
          type: string
        required: true
      tags:
      - public
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PublicQROpenSessionRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PublicQROpenSessionRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PublicQROpenSessionRequest'
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PublicQROpenSessionResponse'
          description: ''
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PublicQROpenSessionResponse'
          description: ''
  /api/v1/qr-codes/:
    get:
      operationId: qr_codes_list
      description: Staff management of cryptographic QR tokens.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - qr-codes
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedQRCodeList'
          description: ''
  /api/v1/qr-codes/{id}/:
    get:
      operationId: qr_codes_retrieve
      description: Staff management of cryptographic QR tokens.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this qr code.
        required: true
      tags:
      - qr-codes
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QRCode'
          description: ''
    delete:
      operationId: qr_codes_destroy
      description: Staff management of cryptographic QR tokens.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this qr code.
        required: true
      tags:
      - qr-codes
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/qr-codes/{id}/image/:
    get:
      operationId: qr_codes_image_retrieve
      description: Staff management of cryptographic QR tokens.
      parameters:
      - in: query
        name: format
        schema:
          type: string
          enum:
          - png
          - svg
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this qr code.
        required: true
      tags:
      - qr-codes
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            image/png:
              schema:
                $ref: '#/components/schemas/QRCode'
            image/svg+xml:
              schema:
                $ref: '#/components/schemas/QRCode'
          description: ''
  /api/v1/qr-codes/{id}/rotate/:
    post:
      operationId: qr_codes_rotate_create
      description: Staff management of cryptographic QR tokens.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        description: A UUID string identifying this qr code.
        required: true
      tags:
      - qr-codes
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QRCode'
          description: ''
  /api/v1/qr-codes/generate/:
    post:
      operationId: qr_codes_generate_create
      description: Staff management of cryptographic QR tokens.
      tags:
      - qr-codes
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QRCode'
          description: ''
  /api/v1/qr-codes/sheet-data/:
    get:
      operationId: qr_codes_sheet_data_list
      description: Returns list of active QR codes with table, area, section names,
        and public URLs.
      summary: Get QR code sheet data
      tags:
      - qr-codes
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/QRCodeSheetItem'
          description: ''
  /api/v1/sections/:
    get:
      operationId: sections_list
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - sections
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSectionList'
          description: ''
    post:
