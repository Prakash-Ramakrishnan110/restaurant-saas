server {
    listen ${PORT} default_server;
    server_name _;

    client_max_body_size 15M;

    # Backend API & Health & WebSockets -> Daphne (127.0.0.1:8000)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 86400;
    }

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "OK\n";
    }

    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /app/media/;
        expires 7d;
    }

    location /assets/ {
        root /app/web;
        try_files /frontend$uri /marketing$uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Prerendered Marketing Pages & Assets
    location = / {
        root /app/web/marketing;
        try_files /index.html =404;
    }

    location ~ ^/(book-demo|privacy|terms|tea-shops|restaurants|hotels)/?$ {
        root /app/web/marketing;
        try_files /$1/index.html =404;
    }

    location ~ ^/(video|fonts|brand)/ {
        root /app/web/marketing;
        try_files $uri =404;
        expires 7d;
    }

    # React SPA (Staff Console & Customer QR Ordering)
    location / {
        root /app/web/frontend;
        try_files $uri $uri/ /index.html;
    }
}
